<Layouts.app flash={@flash}>
  <section id="dashboard" class="mx-auto max-w-5xl">
    <div class="rounded-3xl bg-slate-950 px-7 py-10 text-white shadow-2xl shadow-slate-950/20 sm:px-10">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <div class="mb-5 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">
            <span class="size-2 rounded-full bg-amber-300 shadow-[0_0_0_5px_rgba(252,211,77,0.12)]">
            </span>
            GitHub event relay
          </div>
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Beewop keeps watch.</h1>
          <p class="mt-4 text-lg leading-8 text-slate-300">
            Failed Actions runs and new releases arrive here, then head straight to Discord.
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-sm text-slate-300">
          <div class="flex items-center gap-2 font-medium text-emerald-300">
            <span class="size-2 rounded-full bg-emerald-400"></span> Receiver online
          </div>
          <code class="mt-2 block text-xs text-slate-400">POST /webhooks/github</code>
        </div>
      </div>
    </div>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5 sm:px-8">
        <div>
          <h2 class="font-semibold text-slate-950">Recent notifications</h2>
          <p class="mt-1 text-sm text-slate-500">
            Updates appear live as GitHub calls the webhook.
          </p>
        </div>
        <.icon name="hero-bell-alert" class="size-5 text-amber-500" />
      </div>

      <div id="notifications" phx-update="stream" class="divide-y divide-slate-100">
        <div class={
          if(@notifications_empty?, do: "block px-6 py-14 text-center sm:px-8", else: "hidden")
        }>
          <.icon name="hero-inbox" class="mx-auto size-8 text-slate-300" />
          <p class="mt-3 font-medium text-slate-700">No notifications yet</p>
          <p class="mt-1 text-sm text-slate-500">
            Configure GitHub to send its first event to this receiver.
          </p>
        </div>

        <article
          :for={{id, notification} <- @streams.notifications}
          id={id}
          class="group flex gap-4 px-6 py-5 transition hover:bg-slate-50 sm:px-8"
        >
          <div class="mt-1 flex size-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 transition group-hover:bg-amber-100 group-hover:text-amber-700">
            <.icon
              name={
                if(notification.event_type == "workflow_failure",
                  do: "hero-x-circle",
                  else: "hero-tag"
                )
              }
              class="size-5"
            />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <p class="truncate font-medium text-slate-900">{notification.title}</p>
              <span class={[
                "inline-flex w-fit shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset",
                status_class(notification.status)
              ]}>
                {status_label(notification.status)}
              </span>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
              <span>{notification.repository}</span>
              <span class="hidden text-slate-300 sm:inline">•</span>
              <time>{timestamp(notification)}</time>
              <%= if notification.url do %>
                <a
                  href={notification.url}
                  class="font-medium text-indigo-600 transition hover:text-indigo-800"
                  target="_blank"
                  rel="noreferrer"
                >
                  Open on GitHub
                </a>
              <% end %>
            </div>
            <%= if notification.delivery_error do %>
              <p class="mt-2 text-sm text-rose-600">{notification.delivery_error}</p>
            <% end %>
          </div>
        </article>
      </div>
    </section>
  </section>
</Layouts.app>
